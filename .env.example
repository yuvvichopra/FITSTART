# FitStart Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=fitstart-super-secret-key-change-in-production-2026

# Database Configuration:
# For MySQL (preferred for production/full setup):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fitstart
# For Local Development fallback (zero setup required):
DATABASE_URL=sqlite:///fitstart.db

# Host and Port Configuration
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
